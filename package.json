{
    "name": "map-viewer",
    "version": "1.0.0",
    "description": "Vendor-neutral map viewer with street view support",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "compile": "tsc",
        "copy-html": "copy index.html dist\\",
        "build": "npm run compile && npm run copy-html",
        "start": "http-server . -p 8080",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist"
    },
    "dependencies": {
        "@types/google.maps": "^3.54.0"
    },
    "devDependencies": {
        "@types/leaflet": "^1.9.17",
        "gh-pages": "^6.3.0",
        "http-server": "^14.1.1",
        "typescript": "^5.0.0"
    }
}